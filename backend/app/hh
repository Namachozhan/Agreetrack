
apiVersion: image.openshift.io/v1
kind: ImageStream
metadata:
  name: agritrack-backend
  namespace: chozhanaws3-dev
---
apiVersion: build.openshift.io/v1
kind: BuildConfig
metadata:
  name: agritrack-backend
  namespace: chozhanaws3-dev
spec:
  runPolicy: Serial
  source:
    type: Git
    git:
      uri: https://github.com/Namachozhan/AgriTrack.git
      ref: main
    contextDir: backend
  strategy:
    type: Docker
    dockerStrategy:
      dockerfilePath: Dockerfile
  output:
    to:
      kind: ImageStreamTag
      name: agritrack-backend:latest
  triggers:
    - type: ConfigChange

